0c32\u0c3f\u0c35\u0c30\u0c40 \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, 499 \u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c32 \u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d\u0c32\u0c15\u0c41 \u0c2b\u0c4d\u0c30\u0c40 \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.\n\n\nINTENT: PAYMENT\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c2f\u0c42\u0c2a\u0c40\u0c10 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2f\u0c42\u0c2a\u0c40\u0c10 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c17\u0c42\u0c17\u0c41\u0c32\u0c4d \u0c2a\u0c47 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c17\u0c42\u0c17\u0c41\u0c32\u0c4d \u0c2a\u0c47 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c2b\u0c4b\u0c28\u0c4d\u200c\u0c2a\u0c47 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2b\u0c4b\u0c28\u0c4d\u200c\u0c2a\u0c47 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c15\u0c4d\u0c2f\u0c3e\u0c37\u0c4d \u0c06\u0c28\u0c4d \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c15\u0c4d\u0c2f\u0c3e\u0c37\u0c4d \u0c06\u0c28\u0c4d \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c15\u0c42\u0c21\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f.\n\n\nINTENT: OFFERS\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c08\u0c30\u0c4b\u0c1c\u0c41 \u0c0f\u0c2e\u0c48\u0c28\u0c3e \u0c06\u0c2b\u0c30\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c17\u0c4d\u0c30\u0c4b\u0c38\u0c30\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d\u0c38\u0c4d\u200c\u0c2a\u0c48 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c06\u0c2b\u0c30\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c2c\u0c3f\u0c2f\u0c4d\u0c2f\u0c02\u0c2a\u0c48 \u0c21\u0c3f\u0c38\u0c4d\u0c15\u0c4c\u0c02\u0c1f\u0c4d \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2c\u0c3f\u0c2f\u0c4d\u0c2f\u0c02 \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d\u0c32\u0c2a\u0c48 \u0c21\u0c3f\u0c38\u0c4d\u0c15\u0c4c\u0c02\u0c1f\u0c4d \u0c09\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c2c\u0c3f\u0c38\u0c4d\u0c15\u0c46\u0c1f\u0c4d\u0c32\u0c2a\u0c48 \u0c06\u0c2b\u0c30\u0c4d \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2c\u0c3f\u0c38\u0c4d\u0c15\u0c46\u0c1f\u0c4d \u0c2a\u0c4d\u0c2f\u0c3e\u0c15\u0c46\u0c1f\u0c4d\u0c32\u0c2a\u0c48 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c06\u0c2b\u0c30\u0c4d \u0c09\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c0f\u0c2e\u0c48\u0c28\u0c3e \u0c21\u0c3f\u0c38\u0c4d\u0c15\u0c4c\u0c02\u0c1f\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c1a\u0c3e\u0c32\u0c3e \u0c17\u0c4d\u0c30\u0c4b\u0c38\u0c30\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d\u0c38\u0c4d\u200c\u0c2a\u0c48 \u0c06\u0c2b\u0c30\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.\n\n\nINTENT: STORE_HOURS\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c2e\u0c40 \u0c37\u0c3e\u0c2a\u0c4d \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c13\u0c2a\u0c46\u0c28\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c2e\u0c3e \u0c37\u0c3e\u0c2a\u0c4d \u0c09\u0c26\u0c2f\u0c02 7 \u0c17\u0c02\u0c1f\u0c32\u0c15\u0c41 \u0c13\u0c2a\u0c46\u0c28\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c37\u0c3e\u0c2a\u0c4d \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c15\u0c4d\u0c32\u0c4b\u0c1c\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c2e\u0c3e \u0c37\u0c3e\u0c2a\u0c4d \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10 \u0c17\u0c02\u0c1f\u0c32\u0c15\u0c41 \u0c15\u0c4d\u0c32\u0c4b\u0c1c\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c30\u0c47\u0c2a\u0c41 \u0c37\u0c3e\u0c2a\u0c4d \u0c13\u0c2a\u0c46\u0c28\u0c4d \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c30\u0c47\u0c2a\u0c41 \u0c09\u0c26\u0c2f\u0c02 7 \u0c17\u0c02\u0c1f\u0c32 \u0c28\u0c41\u0c02\u0c1a\u0c3f \u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 10 \u0c17\u0c02\u0c1f\u0c32 \u0c35\u0c30\u0c15\u0c41 \u0c13\u0c2a\u0c46\u0c28\u0c4d \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.\n\n\nINTENT: COMPLAINT\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c02\u0c26\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c15\u0c41 \u0c0f \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c17\u0c3e \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c02\u0c26\u0c4b \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c35\u0c41\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f, \u0c28\u0c47\u0c28\u0c41 \u0c1a\u0c46\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c21\u0c4d\u0c2f\u0c3e\u0c2e\u0c47\u0c1c\u0c4d \u0c05\u0c2f\u0c3f\u0c28 \u0c2a\u0c3e\u0c32\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3e\u0c2f\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f \u0c30\u0c40\u0c2a\u0c4d\u0c32\u0c47\u0c38\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\nINTENT: REFUND\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c30\u0c40\u0c2b\u0c02\u0c21\u0c4d \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c21\u0c4d\u0c2f\u0c3e\u0c2e\u0c47\u0c1c\u0c4d \u0c05\u0c2f\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c02\u0c26\u0c3f. \u0c21\u0c2c\u0c4d\u0c2c\u0c41\u0c32\u0c41 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c1a\u0c46\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c30\u0c40\u0c2b\u0c02\u0c21\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\nINTENT: CANCEL_ORDER\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c15\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f. \u0c15\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c2e\u0c4b \u0c1a\u0c46\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c35\u0c26\u0c4d\u0c26\u0c41.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c15\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c15\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f.\n\n\nINTENT: HUMAN_AGENT\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c47\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c2e\u0c3e\u0c1f\u0c4d\u0c32\u0c3e\u0c21\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c3f\u0c15\u0c3f \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c12\u0c15 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c24\u0c4b \u0c2e\u0c3e\u0c1f\u0c4d\u0c32\u0c3e\u0c21\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c40 \u0c15\u0c3e\u0c32\u0c4d\u200c\u0c28\u0c41 \u0c2e\u0c3e \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d \u0c1f\u0c40\u0c2e\u0c4d\u200c\u0c15\u0c41 \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c47\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c15\u0c4a\u0c26\u0c4d\u0c26\u0c3f\u0c38\u0c47\u0c2a\u0c41 \u0c35\u0c47\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f.\n\n\nINTENT: PRODUCT_ALTERNATIVE\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c08 \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d \u0c35\u0c26\u0c4d\u0c26\u0c41. \u0c07\u0c02\u0c15\u0c47\u0c26\u0c48\u0c28\u0c3e \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c07\u0c26\u0c47 \u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c07\u0c24\u0c30 \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c27\u0c30\u0c32\u0c4b \u0c07\u0c02\u0c15\u0c47\u0c26\u0c48\u0c28\u0c3e \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c27\u0c30\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c3e\u0c2e\u0c4d\u0c28\u0c3e\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c46\u0c2c\u0c41\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c35\u0c47\u0c30\u0c47 \u0c2c\u0c3f\u0c2f\u0c4d\u0c2f\u0c02 \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2e\u0c3e \u0c26\u0c17\u0c4d\u0c17\u0c30 \u0c1a\u0c3e\u0c32\u0c3e \u0c2c\u0c3f\u0c2f\u0c4d\u0c2f\u0c02 \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.\n\n\nINTENT: GREETING\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c39\u0c32\u0c4b.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c28\u0c2e\u0c38\u0c4d\u0c15\u0c3e\u0c30\u0c02! \u0c2e\u0c3e \u0c38\u0c42\u0c2a\u0c30\u0c4d\u200c\u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c46\u0c1f\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02. \u0c2e\u0c40\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c2e\u0c38\u0c4d\u0c24\u0c47.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c28\u0c2e\u0c38\u0c4d\u0c24\u0c47! \u0c2e\u0c40\u0c15\u0c41 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c17\u0c4d\u0c30\u0c4b\u0c38\u0c30\u0c40 \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c35\u0c41\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c02\u0c32\u0c4b \u0c28\u0c47\u0c28\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c17\u0c41\u0c21\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c28\u0c3f\u0c02\u0c17\u0c4d.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c17\u0c41\u0c21\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c28\u0c3f\u0c02\u0c17\u0c4d! \u0c2e\u0c40\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?\n\n\nINTENT: END_CALL\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c05\u0c02\u0c24\u0c47.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c3e \u0c38\u0c42\u0c2a\u0c30\u0c4d\u200c\u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c46\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c27\u0c28\u0c4d\u0c2f\u0c35\u0c3e\u0c26\u0c3e\u0c32\u0c41. \u0c2e\u0c40 \u0c30\u0c4b\u0c1c\u0c41 \u0c36\u0c41\u0c2d\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c07\u0c02\u0c15\u0c47\u0c2e\u0c40 \u0c35\u0c26\u0c4d\u0c26\u0c41.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c3e\u0c24\u0c4b \u0c2e\u0c3e\u0c1f\u0c4d\u0c32\u0c3e\u0c21\u0c3f\u0c28\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c27\u0c28\u0c4d\u0c2f\u0c35\u0c3e\u0c26\u0c3e\u0c32\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c25\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d\u0c2f\u0c42.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c2e\u0c40\u0c15\u0c41 \u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02. \u0c27\u0c28\u0c4d\u0c2f\u0c35\u0c3e\u0c26\u0c3e\u0c32\u0c41!\n\n\nMULTI-TURN CONVERSATION\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c39\u0c32\u0c4b.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c28\u0c2e\u0c38\u0c4d\u0c15\u0c3e\u0c30\u0c02! \u0c2e\u0c3e \u0c38\u0c42\u0c2a\u0c30\u0c4d\u200c\u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c46\u0c1f\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02. \u0c2e\u0c40\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e\u0c15\u0c41 \u0c2a\u0c3e\u0c32\u0c41 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c2e\u0c40\u0c15\u0c41 \u0c0f \u0c2c\u0c4d\u0c30\u0c3e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c32\u0c41 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c05\u0c2e\u0c42\u0c32\u0c4d \u0c2a\u0c3e\u0c32\u0c41 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c12\u0c15 \u0c32\u0c40\u0c1f\u0c30\u0c4d \u0c05\u0c2e\u0c42\u0c32\u0c4d \u0c2a\u0c3e\u0c32\u0c41 64 \u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c32\u0c41. \u0c2e\u0c40\u0c15\u0c41 \u0c0e\u0c28\u0c4d\u0c28\u0c3f \u0c32\u0c40\u0c1f\u0c30\u0c4d\u0c32\u0c41 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c32\u0c40\u0c1f\u0c30\u0c4d\u0c32\u0c41.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c32\u0c40\u0c1f\u0c30\u0c4d\u0c32 \u0c05\u0c2e\u0c42\u0c32\u0c4d \u0c2a\u0c3e\u0c32\u0c28\u0c41 \u0c2e\u0c40 \u0c15\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c2f\u0c3e\u0c21\u0c4d \u0c1a\u0c47\u0c36\u0c3e\u0c28\u0c41. \u0c07\u0c02\u0c15\u0c47\u0c2e\u0c48\u0c28\u0c3e \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c2e\u0c4d\u0c2f\u0c3e\u0c17\u0c40 \u0c2a\u0c4d\u0c2f\u0c3e\u0c15\u0c46\u0c1f\u0c4d\u0c32\u0c41 \u0c15\u0c42\u0c21\u0c3e \u0c2f\u0c3e\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e. \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c2e\u0c4d\u0c2f\u0c3e\u0c17\u0c40 \u0c2a\u0c4d\u0c2f\u0c3e\u0c15\u0c46\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c15\u0c42\u0c21\u0c3e \u0c2f\u0c3e\u0c21\u0c4d \u0c1a\u0c47\u0c36\u0c3e\u0c28\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c28\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c1f\u0c4d \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c0e\u0c02\u0c24?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c2e\u0c40 \u0c15\u0c3e\u0c30\u0c4d\u0c1f\u0c4d \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 156 \u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c32\u0c41.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c2a\u0c46\u0c1f\u0c4d\u0c1f\u0c02\u0c21\u0c3f.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c38\u0c30\u0c47. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c4d\u0c32\u0c47\u0c38\u0c4d \u0c05\u0c2f\u0c3f\u0c02\u0c26\u0c3f. \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d 30 \u0c28\u0c41\u0c02\u0c1a\u0c3f 45 \u0c28\u0c3f\u0c2e\u0c3f\u0c37\u0c3e\u0c32\u0c4d\u0c32\u0c4b \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c25\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d\u0c2f\u0c42.\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c2e\u0c40\u0c15\u0c41 \u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02. \u0c27\u0c28\u0c4d\u0c2f\u0c35\u0c3e\u0c26\u0c3e\u0c32\u0c41!\n\n\n\u0c38\u0c39\u0c1c\u0c2e\u0c48\u0c28 \u0c24\u0c46\u0c32\u0c41\u0c17\u0c41 \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d EXAMPLES\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c05\u0c28\u0c4d\u0c28\u0c3e, \u0c12\u0c15 \u0c15\u0c3f\u0c32\u0c4b \u0c37\u0c41\u0c17\u0c30\u0c4d \u0c09\u0c02\u0c26\u0c3e?\n\u0c0f\u0c1c\u0c46\u0c02\u0c1f\u0c4d: \u0c09\u0c02\u0c26\u0c3f. \u0c12\u0c15 \u0c15\u0c3f\u0c32\u0c4b \u0c37\u0c41\u0c17\u0c30\u0c4d 52 \u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c32\u0c41. \u0c15\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c2f\u0c3e\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c28\u0c3e?\n\n\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d: \u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2f\u0c3e\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.\n\u0c0f\u0c1c\u0c46\u0