APP_NAME=Voice Call Agent
ENVIRONMENT=development
# Set this to your public HTTPS URL when configuring a telephony webhook.
PUBLIC_BASE_URL=http://localhost:8000
# Experiential Labs Gateway
EXPLABS_API_KEY=your_explabs_api_key_here
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Telephony Provider: "twilio" or "exotel"
TELEPHONY_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
VALIDATE_TELEPHONY_SIGNATURES=false

# Exotel Configuration (https://my.exotel.com/apps#installed-apps)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=0XXXXXXXXX
EXOTEL_APP_ID=your_installed_app_id_here

